[Unit]
Description=SSH reverse tunnel for Tanmatsu serial ports
BindsTo=dev-tanmatsu_p6.device
After=dev-tanmatsu_p6.device
After=network-online.target
Wants=network-online.target

[Service]
User=cavac
Environment=HOME=/home/cavac
ExecStart=/usr/bin/ssh -R 4000:127.0.0.1:4000 -R 4001:127.0.0.1:4001 -R 4002:127.0.0.1:4002 -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o BatchMode=yes cavac@cavac.at
Restart=on-failure
RestartSec=5
