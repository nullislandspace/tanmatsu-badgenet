# Tanmatsu ESP32-P4 (application processor) - JTAG/serial debug unit
# Only appears in firmware flash mode
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ATTRS{serial}=="30:ED:A0:E2:F4:A8", SYMLINK+="tanmatsu_p4", TAG+="systemd", ENV{SYSTEMD_WANTS}="ser2net-tanmatsu-p4.service"

# Tanmatsu ESP32-P6 (radio processor) - JTAG/serial debug unit
# Present in all modes — also triggers the SSH tunnel
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ATTRS{serial}=="CC:BA:97:E1:E7:F8", SYMLINK+="tanmatsu_p6", TAG+="systemd", ENV{SYSTEMD_WANTS}="ser2net-tanmatsu-p6.service tanmatsu-tunnel.service"

# Tanmatsu BadgeLink (P4 in badgelink mode) - custom USB device
# Only appears in badgelink mode
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="16d0", ATTR{idProduct}=="0f9a", SYMLINK+="tanmatsu_badgelink", TAG+="systemd", ENV{SYSTEMD_WANTS}="badgelinkproxy.service"
